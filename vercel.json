{
  "cleanUrls": true,
  "alias": ["dong-review-public"],
  "redirects": [
    {"source": "/", "destination": "/review/", "permanent": false},
    {"source": "/api/review", "destination": "/api/review3", "permanent": false}
  ],
  "rewrites": [
    {"source": "/review", "destination": "/review/v59.html"},
    {"source": "/review/", "destination": "/review/v59.html"}
  ],
  "headers": [
    {"source": "/review", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/review/", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/review/v59.html", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/review/app59.js", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/api/review", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/api/review3", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/api/place-search", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/api/menu-resolve", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/api/posts", "headers": [{"key": "Cache-Control", "value": "s-maxage=180, stale-while-revalidate=600"}]}
  ]
}